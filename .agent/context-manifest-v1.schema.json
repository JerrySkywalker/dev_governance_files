{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jerryskywalker.space/schemas/agent-context-manifest-v1.schema.json",
  "title": "Jerry Agent Context Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "repository",
    "defaults",
    "context_classes",
    "routes",
    "task_routes",
    "adapter_outputs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": { "const": "JERRY_AGENT_CONTEXT_V1" },
    "repository": { "type": "string" },
    "defaults": { "type": "object" },
    "context_classes": { "type": "object" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["glob", "context_class", "normative", "execution", "edit"]
      }
    },
    "task_routes": { "type": "object" },
    "adapter_outputs": { "type": "object" }
  }
}
