{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protected-a5-legacy-compatibility-preparation.v1",
  "type": "object",
  "required": [
    "schema",
    "compatibility_id",
    "created_utc",
    "expected_lease_sha256",
    "expected_goal",
    "expected_holder_session",
    "legacy_goal_ref_literal",
    "transaction_id",
    "expected_terminal_result",
    "expected_terminal_failure_code",
    "governance_provenance_path",
    "expected_governance_provenance_sha256",
    "source_goal_record_path",
    "expected_source_goal_record_sha256",
    "source_scope_record_path",
    "expected_source_scope_record_sha256",
    "source_budget_record_path",
    "expected_source_budget_record_sha256",
    "source_reconciliation_receipt_path",
    "expected_source_reconciliation_receipt_sha256",
    "source_independent_verifier_receipt_path",
    "expected_source_independent_verifier_receipt_sha256",
    "compatibility_provenance_status"
  ],
  "properties": {
    "schema": {"const": "protected-a5-legacy-compatibility-preparation.v1"},
    "compatibility_id": {"$ref": "#/$defs/identifier"},
    "created_utc": {"type": "string", "format": "date-time"},
    "expected_lease_sha256": {"$ref": "#/$defs/sha256"},
    "expected_goal": {"$ref": "#/$defs/identifier"},
    "expected_holder_session": {"$ref": "#/$defs/identifier"},
    "legacy_goal_ref_literal": {"$ref": "#/$defs/boundedString"},
    "transaction_id": {"$ref": "#/$defs/identifier"},
    "expected_terminal_result": {"const": "FAILED_BEFORE_CONFIG"},
    "expected_terminal_failure_code": {"const": "OWNER_ABORTED_PREPARED"},
    "governance_provenance_path": {"$ref": "#/$defs/boundedString"},
    "expected_governance_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "source_goal_record_path": {"$ref": "#/$defs/boundedString"},
    "expected_source_goal_record_sha256": {"$ref": "#/$defs/sha256"},
    "source_scope_record_path": {"$ref": "#/$defs/boundedString"},
    "expected_source_scope_record_sha256": {"$ref": "#/$defs/sha256"},
    "source_budget_record_path": {"$ref": "#/$defs/boundedString"},
    "expected_source_budget_record_sha256": {"$ref": "#/$defs/sha256"},
    "source_reconciliation_receipt_path": {"$ref": "#/$defs/boundedString"},
    "expected_source_reconciliation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "source_independent_verifier_receipt_path": {"$ref": "#/$defs/boundedString"},
    "expected_source_independent_verifier_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "compatibility_provenance_status": {"const": "ACCEPTED_IMMUTABLE_PREDECESSOR_EVIDENCE"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "boundedString": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f]+$"}
  },
  "additionalProperties": false
}
