{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protected-a5-governance-finalization-receipt.v1",
  "type": "object",
  "required": [
    "schema",
    "finalization_id",
    "finalization_status",
    "finalized_utc",
    "transaction_id",
    "terminal_result",
    "terminal_failure_code",
    "goal",
    "run_id",
    "source_relative_path",
    "historical_relative_path",
    "original_lease_schema",
    "original_lease_sha256",
    "goal_metadata_sha256",
    "budget_metadata_sha256",
    "authorization_sha256",
    "finalization_evidence_sha256",
    "reconciliation_receipt_sha256",
    "independent_verifier_receipt_sha256",
    "production_transaction_mutated"
  ],
  "properties": {
    "schema": {"const": "protected-a5-governance-finalization-receipt.v1"},
    "finalization_id": {"type": "string", "pattern": "^sha256-[0-9a-f]{64}$"},
    "finalization_status": {"const": "PROTECTED_A5_GOVERNANCE_RELEASED"},
    "finalized_utc": {"type": "string", "format": "date-time"},
    "transaction_id": {"$ref": "#/$defs/identifier"},
    "terminal_result": {"const": "FAILED_BEFORE_CONFIG"},
    "terminal_failure_code": {"const": "OWNER_ABORTED_PREPARED"},
    "goal": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "source_relative_path": {"const": ".coord-local/leases/taskroot-writer.active.json"},
    "historical_relative_path": {"type": "string", "pattern": "^\\.coord-local/leases/history/protected-a5/leases/[0-9a-f]{64}\\.writer-lease\\.v1\\.json$"},
    "original_lease_schema": {"const": "jpc.taskroot-writer-lease.v1"},
    "original_lease_sha256": {"$ref": "#/$defs/sha256"},
    "goal_metadata_sha256": {"$ref": "#/$defs/sha256"},
    "budget_metadata_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_sha256": {"$ref": "#/$defs/sha256"},
    "finalization_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "reconciliation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "independent_verifier_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "production_transaction_mutated": {"const": false}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
