{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protected-a5-finalization-evidence.v1",
  "type": "object",
  "required": [
    "schema",
    "evidence_id",
    "created_utc",
    "expected_lease_sha256",
    "goal",
    "run_id",
    "goal_metadata_sha256",
    "budget_metadata_sha256",
    "transaction_id",
    "transaction_terminal",
    "terminal_result",
    "terminal_failure_code",
    "reconciliation_status",
    "final_supervisor_status",
    "fresh_transaction_evidence",
    "live_prestate_status",
    "configuration_mutation_status",
    "rollback_packet_status",
    "rollback_status",
    "no_unresolved_protected_mutation",
    "no_contradictory_later_transaction_evidence",
    "no_fabricated_historical_receipt",
    "unresolved_rollback",
    "conflicting_evidence",
    "accepted_target_status",
    "final_protected_verification_status",
    "reconciliation_receipt_path",
    "reconciliation_receipt_sha256",
    "independent_verifier_receipt_path",
    "independent_verifier_receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "protected-a5-finalization-evidence.v1"},
    "evidence_id": {"$ref": "#/$defs/identifier"},
    "created_utc": {"type": "string", "format": "date-time"},
    "expected_lease_sha256": {"$ref": "#/$defs/sha256"},
    "goal": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "goal_metadata_sha256": {"$ref": "#/$defs/sha256"},
    "budget_metadata_sha256": {"$ref": "#/$defs/sha256"},
    "transaction_id": {"$ref": "#/$defs/identifier"},
    "transaction_terminal": {"const": true},
    "terminal_result": {"const": "FAILED_BEFORE_CONFIG"},
    "terminal_failure_code": {"const": "OWNER_ABORTED_PREPARED"},
    "reconciliation_status": {"const": "PASS"},
    "final_supervisor_status": {"const": "PASS"},
    "fresh_transaction_evidence": {"const": true},
    "live_prestate_status": {"const": "EXACT"},
    "configuration_mutation_status": {"const": "NONE_UNRESOLVED"},
    "rollback_packet_status": {"const": "VALIDATED_WHERE_RELEVANT"},
    "rollback_status": {"const": "NOT_REQUIRED"},
    "no_unresolved_protected_mutation": {"const": true},
    "no_contradictory_later_transaction_evidence": {"const": true},
    "no_fabricated_historical_receipt": {"const": true},
    "unresolved_rollback": {"const": false},
    "conflicting_evidence": {"const": false},
    "accepted_target_status": {"const": "NOT_APPLICABLE"},
    "final_protected_verification_status": {"const": "NOT_APPLICABLE"},
    "reconciliation_receipt_path": {"type": "string", "pattern": "^\\.coord-local/receipts/[A-Za-z0-9._/-]+\\.json$"},
    "reconciliation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "independent_verifier_receipt_path": {"type": "string", "pattern": "^\\.coord-local/receipts/[A-Za-z0-9._/-]+\\.json$"},
    "independent_verifier_receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
