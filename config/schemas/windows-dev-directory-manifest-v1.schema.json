{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jerryskywalker.dev/schemas/windows-dev-directory-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "roots",
    "c_dev_directories",
    "v_work_directories",
    "v_optional_python_cache_directories",
    "invariants"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "manifest_id": { "const": "JERRY_WINDOWS_DEV_DIRECTORY_MANIFEST_V1" },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c_dev", "v_work"],
      "properties": {
        "c_dev": { "const": "C:\\Dev" },
        "v_work": { "const": "V:\\" }
      }
    },
    "c_dev_directories": { "$ref": "#/$defs/directory_entries" },
    "v_work_directories": { "$ref": "#/$defs/directory_entries" },
    "v_optional_python_cache_directories": { "$ref": "#/$defs/directory_entries" },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory_bootstrap_installs_software",
        "v_python_caches_opt_in_only",
        "vhdx_creation_or_replacement",
        "production_or_device_mutation"
      ],
      "properties": {
        "directory_bootstrap_installs_software": { "const": false },
        "v_python_caches_opt_in_only": { "const": true },
        "vhdx_creation_or_replacement": { "const": false },
        "production_or_device_mutation": { "const": false }
      }
    }
  },
  "$defs": {
    "directory_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "purpose"],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(\\.|[A-Za-z0-9][A-Za-z0-9._ -]*(\\\\[A-Za-z0-9][A-Za-z0-9._ -]*)*)$"
          },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
