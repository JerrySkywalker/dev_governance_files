{
  "$schema": "./schemas/windows-dev-directory-manifest-v1.schema.json",
  "schema_version": 1,
  "manifest_id": "JERRY_WINDOWS_DEV_DIRECTORY_MANIFEST_V1",
  "roots": {
    "c_dev": "C:\\Dev",
    "v_work": "V:\\"
  },
  "c_dev_directories": [
    { "relative_path": ".", "purpose": "stable governance root" },
    { "relative_path": "tools", "purpose": "stable tool state parent" },
    { "relative_path": "tools\\bin", "purpose": "stable CLI and shim surface" },
    { "relative_path": "tools\\uv-tools", "purpose": "uv persistent CLI-tool state" },
    { "relative_path": "tools\\uv-python", "purpose": "uv-managed Python runtime state" },
    { "relative_path": "toolchains", "purpose": "governed toolchain parent" },
    { "relative_path": "toolchains\\flutter", "purpose": "Flutter toolchain" },
    { "relative_path": "toolchains\\vcpkg", "purpose": "vcpkg toolchain" },
    { "relative_path": "toolchains\\qt", "purpose": "Qt toolchain" },
    { "relative_path": "toolchains\\qt-legacy", "purpose": "legacy Qt toolchain" },
    { "relative_path": "toolchains\\android-sdk", "purpose": "Android SDK toolchain" },
    { "relative_path": "toolchains\\miniconda3", "purpose": "Miniconda installation root" },
    { "relative_path": "envs", "purpose": "governed environment parent" },
    { "relative_path": "envs\\conda", "purpose": "Conda environment root" },
    { "relative_path": "cache", "purpose": "C-only cache parent" },
    { "relative_path": "cache\\uv", "purpose": "uv cache" },
    { "relative_path": "cache\\pip", "purpose": "pip cache" },
    { "relative_path": "cache\\conda-pkgs", "purpose": "Conda package cache" },
    { "relative_path": "backups", "purpose": "lightweight backup parent" },
    { "relative_path": "backups\\conda", "purpose": "Conda backup and export root" },
    { "relative_path": "backups\\env-snapshots", "purpose": "environment snapshot and pre-change environment evidence root" },
    { "relative_path": "mcp", "purpose": "MCP integration parent" },
    { "relative_path": "mcp\\servers", "purpose": "MCP server parent" },
    { "relative_path": "mcp\\servers\\matlab-mcp-core-server", "purpose": "MATLAB MCP server root" },
    { "relative_path": "mcp\\servers\\matlab-mcp-core-server\\bin", "purpose": "MATLAB MCP binary root" },
    { "relative_path": "mcp\\servers\\matlab-mcp-core-server\\releases", "purpose": "MATLAB MCP release root" },
    { "relative_path": "mcp\\toolkits", "purpose": "MCP toolkit parent" },
    { "relative_path": "mcp\\toolkits\\matlab-agentic-toolkit", "purpose": "MATLAB Agentic Toolkit root" },
    { "relative_path": "mcp\\configs", "purpose": "MCP configuration parent" },
    { "relative_path": "mcp\\configs\\codex", "purpose": "Codex MCP configuration parent" },
    { "relative_path": "mcp\\configs\\codex\\templates", "purpose": "Codex MCP template root" },
    { "relative_path": "mcp\\docs", "purpose": "MCP documentation root" },
    { "relative_path": "mcp\\logs", "purpose": "MCP sanitized-log root" },
    { "relative_path": "resources", "purpose": "shared resource parent" },
    { "relative_path": "resources\\stk", "purpose": "STK resource parent" },
    { "relative_path": "resources\\stk\\satellites", "purpose": "STK satellite resources" },
    { "relative_path": "resources\\stk\\terrain", "purpose": "STK terrain resources" },
    { "relative_path": "resources\\stk\\imagery", "purpose": "STK imagery resources" },
    { "relative_path": "resources\\stk\\templates", "purpose": "STK template resources" },
    { "relative_path": "resources\\common-data", "purpose": "shared common data" },
    { "relative_path": "scripts", "purpose": "machine-level script root" },
    { "relative_path": "docs", "purpose": "machine-level documentation root" },
    { "relative_path": "volumes", "purpose": "Dev Drive VHDX custody root" },
    { "relative_path": "legacy", "purpose": "NTFS legacy compatibility parent" },
    { "relative_path": "legacy\\src", "purpose": "legacy source root" },
    { "relative_path": "legacy\\build", "purpose": "legacy build root" },
    { "relative_path": "legacy\\resources", "purpose": "legacy resource root" },
    { "relative_path": "secrets", "purpose": "local secret custody parent" },
    { "relative_path": "secrets\\ssh", "purpose": "local SSH key custody root" }
  ],
  "v_work_directories": [
    { "relative_path": "src", "purpose": "active source root" },
    { "relative_path": "build", "purpose": "build-output root" },
    { "relative_path": "cache", "purpose": "high-IO cache parent" },
    { "relative_path": "cache\\pub", "purpose": "pub cache" },
    { "relative_path": "cache\\gradle", "purpose": "Gradle cache" },
    { "relative_path": "cache\\vcpkg-downloads", "purpose": "vcpkg download cache" },
    { "relative_path": "cache\\vcpkg-bincache", "purpose": "vcpkg binary cache" },
    { "relative_path": "cache\\temp", "purpose": "temporary cache" },
    { "relative_path": "datasets", "purpose": "dataset parent" },
    { "relative_path": "datasets\\hgv", "purpose": "HGV datasets" },
    { "relative_path": "datasets\\stk-exports", "purpose": "STK exports" },
    { "relative_path": "datasets\\monte-carlo", "purpose": "Monte Carlo datasets" },
    { "relative_path": "scratch", "purpose": "disposable workspace" }
  ],
  "v_optional_python_cache_directories": [
    { "relative_path": "cache\\pip", "purpose": "opt-in pip cache" },
    { "relative_path": "cache\\conda-pkgs", "purpose": "opt-in Conda package cache" }
  ],
  "invariants": {
    "directory_bootstrap_installs_software": false,
    "v_python_caches_opt_in_only": true,
    "vhdx_creation_or_replacement": false,
    "production_or_device_mutation": false
  }
}
